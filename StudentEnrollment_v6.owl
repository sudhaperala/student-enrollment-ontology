    // Rules
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description rdf:about="http://pearson.com/ontology/StudentEnrollment#app">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://pearson.com/ontology/StudentEnrollment#inst">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://pearson.com/ontology/StudentEnrollment#doc">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://pearson.com/ontology/StudentEnrollment#student">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://pearson.com/ontology/StudentEnrollment#parent">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://pearson.com/ontology/StudentEnrollment#addr">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>FIRES ON:  App_TC003 (Uni_MMU is HigherEducation + has Doc_Transcript_Ahmed) NO FIRE:   App_TC008 (university but no transcript submitted)</rdfs:comment>
        <rdfs:label>RULE 9 - HE-1 PASS: Higher education application has Academic Transcript</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://pearson.com/ontology/StudentEnrollment#EnrollmentApplication"/>
                        <swrl:argument1 rdf:resource="http://pearson.com/ontology/StudentEnrollment#app"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://pearson.com/ontology/StudentEnrollment#targetInstitution"/>
                                <swrl:argument1 rdf:resource="http://pearson.com/ontology/StudentEnrollment#app"/>
                                <swrl:argument2 rdf:resource="http://pearson.com/ontology/StudentEnrollment#inst"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                        <swrl:classPredicate rdf:resource="http://pearson.com/ontology/StudentEnrollment#HigherEducation"/>
                                        <swrl:argument1 rdf:resource="http://pearson.com/ontology/StudentEnrollment#inst"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasDocument"/>
                                                <swrl:argument1 rdf:resource="http://pearson.com/ontology/StudentEnrollment#app"/>
                                                <swrl:argument2 rdf:resource="http://pearson.com/ontology/StudentEnrollment#doc"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                        <swrl:classPredicate rdf:resource="http://pearson.com/ontology/StudentEnrollment#AcademicTranscript"/>
                                                        <swrl:argument1 rdf:resource="http://pearson.com/ontology/StudentEnrollment#doc"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://pearson.com/ontology/StudentEnrollment#applicationStatus"/>
                        <swrl:argument1 rdf:resource="http://pearson.com/ontology/StudentEnrollment#app"/>
                        <swrl:argument2>HE-1-PASS</swrl:argument2>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>FIRES: Doc_BirthCert_Isabella_EXE only TC007 | NO FIRE: all others</rdfs:comment>
        <rdfs:label>RULE 6 - FILE FAIL: Document file extension is exe (rejected format)</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://pearson.com/ontology/StudentEnrollment#EnrollmentApplication"/>
                        <swrl:argument1 rdf:resource="http://pearson.com/ontology/StudentEnrollment#app"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasDocument"/>
                        <swrl:argument1 rdf:resource="http://pearson.com/ontology/StudentEnrollment#app"/>
                        <swrl:argument2 rdf:resource="http://pearson.com/ontology/StudentEnrollment#doc"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://pearson.com/ontology/StudentEnrollment#EXEDocument"/>
                        <swrl:argument1 rdf:resource="http://pearson.com/ontology/StudentEnrollment#doc"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
                </rdf:rest>
            </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://pearson.com/ontology/StudentEnrollment#verificationStatus"/>
                        <swrl:argument1 rdf:resource="http://pearson.com/ontology/StudentEnrollment#doc"/>
                        <swrl:argument2>FILE-FAIL</swrl:argument2>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>FIRES ON:  App_TC003 (has Doc_IELTS_Ahmed)   NO FIRE:   App_TC008 (no English cert)</rdfs:comment>
        <rdfs:label>RULE 8 - INTL-3 PASS: International student has English Language Certificate</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://pearson.com/ontology/StudentEnrollment#EnrollmentApplication"/>
                        <swrl:argument1 rdf:resource="http://pearson.com/ontology/StudentEnrollment#app"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://pearson.com/ontology/StudentEnrollment#forStudent"/>
                                <swrl:argument1 rdf:resource="http://pearson.com/ontology/StudentEnrollment#app"/>
                                <swrl:argument2 rdf:resource="http://pearson.com/ontology/StudentEnrollment#student"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                        <swrl:classPredicate rdf:resource="http://pearson.com/ontology/StudentEnrollment#InternationalStudent"/>
                                        <swrl:argument1 rdf:resource="http://pearson.com/ontology/StudentEnrollment#student"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasDocument"/>
                                                <swrl:argument1 rdf:resource="http://pearson.com/ontology/StudentEnrollment#app"/>
                                                <swrl:argument2 rdf:resource="http://pearson.com/ontology/StudentEnrollment#doc"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                        <swrl:classPredicate rdf:resource="http://pearson.com/ontology/StudentEnrollment#EnglishLanguageCertificate"/>
                                                        <swrl:argument1 rdf:resource="http://pearson.com/ontology/StudentEnrollment#doc"/>
                                                    </rdf:Description>
                                                </rdf:first>
