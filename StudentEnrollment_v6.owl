            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#targetInstitution"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Parent"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:label>submitted by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#targetInstitution -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#targetInstitution">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#EnrollmentApplication"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasDocument"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
