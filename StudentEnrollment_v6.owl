    <owl:DatatypeProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#submissionDate">
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#EnrollmentApplication"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasDocument"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#forStudent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#submittedBy"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#targetInstitution"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label>submission date (POR-3: doc must be within 90 days of this)</rdfs:label>
    </owl:DatatypeProperty>
    


