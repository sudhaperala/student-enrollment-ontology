        <rdfs:subClassOf rdf:resource="http://pearson.com/ontology/StudentEnrollment#Student"/>
        <rdfs:comment>Overseas or international student. Requires StudentVisa or BiometricResidencePermit. EnglishLanguageCertificate required. CAS number required for UK Higher Education.</rdfs:comment>
        <rdfs:label>International Student (overseas - visa and immigration documents required)</rdfs:label>
    </owl:Class>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#InternationalStudentDocumentRule -->

    <owl:Class rdf:about="http://pearson.com/ontology/StudentEnrollment#InternationalStudentDocumentRule">
        <rdfs:subClassOf rdf:resource="http://pearson.com/ontology/StudentEnrollment#ValidationRule"/>
        <rdfs:label>International Student Document Validation Rule</rdfs:label>
        <owl:versionInfo>INTL-1: If isInternationalStudent = true then StudentVisa or BiometricResidencePermit is required. INTL-2: Visa must not be expired (visaExpiryDate must be after submissionDate). INTL-3: EnglishLanguageCertificate required (IELTS minimum 6.0 or TOEFL minimum 80). INTL-4: For UK Higher Education, CAS number is required.</owl:versionInfo>
    </owl:Class>
    


