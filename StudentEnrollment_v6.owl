    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://pearson.com/ontology/StudentEnrollment#AcademicTranscript -->

    <owl:Class rdf:about="http://pearson.com/ontology/StudentEnrollment#AcademicTranscript">
        <rdfs:subClassOf rdf:resource="http://pearson.com/ontology/StudentEnrollment#Document"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasFileType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Academic Transcript (required for Higher Education)</rdfs:label>
    </owl:Class>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#Accepted -->

    <owl:Class rdf:about="http://pearson.com/ontology/StudentEnrollment#Accepted">
        <rdfs:subClassOf rdf:resource="http://pearson.com/ontology/StudentEnrollment#ApplicationStatus"/>
        <rdfs:label>Accepted - All documents verified, student enrolled</rdfs:label>
    </owl:Class>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#AcceptedFileType -->

    <owl:Class rdf:about="http://pearson.com/ontology/StudentEnrollment#AcceptedFileType">
        <rdfs:subClassOf rdf:resource="http://pearson.com/ontology/StudentEnrollment#DocumentFileType"/>
        <owl:disjointWith rdf:resource="http://pearson.com/ontology/StudentEnrollment#RejectedFileType"/>
        <rdfs:label>Accepted File Type</rdfs:label>
    </owl:Class>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#Address -->

    <owl:Class rdf:about="http://pearson.com/ontology/StudentEnrollment#Address">
        <rdfs:label>Address</rdfs:label>
    </owl:Class>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#AdoptionRecord -->

    <owl:Class rdf:about="http://pearson.com/ontology/StudentEnrollment#AdoptionRecord">
        <rdfs:subClassOf rdf:resource="http://pearson.com/ontology/StudentEnrollment#ProofOfAddress"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasFileType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Adoption Record</rdfs:label>
    </owl:Class>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#AdultStudent -->

    <owl:Class rdf:about="http://pearson.com/ontology/StudentEnrollment#AdultStudent">
        <rdfs:subClassOf rdf:resource="http://pearson.com/ontology/StudentEnrollment#Student"/>
        <owl:disjointWith rdf:resource="http://pearson.com/ontology/StudentEnrollment#MinorStudent"/>
