    </owl:DatatypeProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#visaNumber -->

    <owl:DatatypeProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#visaNumber">
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Document"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#ImmigrationDocument"/>
