<?xml version="1.0"?>
<rdf:RDF xmlns="http://pearson.com/ontology/StudentEnrollment#"
     xml:base="http://pearson.com/ontology/StudentEnrollment"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://pearson.com/ontology/StudentEnrollment">
        <owl:versionIRI rdf:resource="http://pearson.com/ontology/StudentEnrollment"/>
        <rdfs:comment>Complete enrollment ontology: Lower/Secondary/Higher Education, Parent, Student, Address, POA/POR documents, file type validation, sibling links, emergency contact, and all validation rules.</rdfs:comment>
        <rdfs:label>Student Enrollment Ontology v4 - Full with Education Levels</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://pearson.com/ontology/StudentEnrollment#addressOf -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#addressOf">
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Document"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#ProofOfResidence"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasFileType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Address"/>
        <rdfs:comment>Links a Proof of Residence document to the Address individual it verifies</rdfs:comment>
        <rdfs:label>addressOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#belongsToApplication -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#belongsToApplication">
        <owl:inverseOf rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasDocument"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Document"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasFileType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#EnrollmentApplication"/>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasDocument"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#forStudent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#submittedBy"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#targetInstitution"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:label>belongs to application</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#forStudent -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#forStudent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#EnrollmentApplication"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasDocument"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#forStudent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#submittedBy"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#targetInstitution"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Student"/>
        <rdfs:label>for student</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#hasAddress -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#hasAddress">
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Address"/>
        <rdfs:label>has address</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#hasApplicationStatus -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#hasApplicationStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#EnrollmentApplication"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasDocument"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#forStudent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#submittedBy"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#targetInstitution"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#ApplicationStatus"/>
        <rdfs:label>has application status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#hasDocument -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#hasDocument">
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#EnrollmentApplication"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasDocument"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#forStudent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#submittedBy"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#targetInstitution"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Document"/>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasFileType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:label>has document</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#hasEmergencyContact -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#hasEmergencyContact">
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Student"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#EmergencyContact"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:label>has emergency contact</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#hasFather -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#hasFather">
        <rdfs:subPropertyOf rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasParent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Student"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Father"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Parent"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:label>has father</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#hasFileType -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#hasFileType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Document"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasFileType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#DocumentFileType"/>
        <rdfs:label>has file type (must be AcceptedFileType)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#hasMother -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#hasMother">
        <rdfs:subPropertyOf rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasParent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Student"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Mother"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Parent"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:label>has mother</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#hasParent -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#hasParent">
        <owl:inverseOf rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasStudent"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Student"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Parent"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:label>has parent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#hasSibling -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#hasSibling">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Student"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Student"/>
        <rdfs:label>has sibling (symmetric)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#hasStudent -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#hasStudent">
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Parent"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Student"/>
        <rdfs:label>has student</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#nameMatchesFather -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#nameMatchesFather">
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Document"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasFileType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:comment>Links a document to the parent whose name appears on that document (name match)</rdfs:comment>
        <rdfs:label>nameMatchesFather</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#nameMismatchFather -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#nameMismatchFather">
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Document"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasFileType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:comment>Links a document to the parent whose name does NOT match the document (name mismatch — TC004)</rdfs:comment>
        <rdfs:label>nameMismatchFather</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#reviewedBy -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#reviewedBy">
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#EnrollmentApplication"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasDocument"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#forStudent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#submittedBy"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#targetInstitution"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:label>reviewed by (staff member)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#submitsApplication -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#submitsApplication">
        <owl:inverseOf rdf:resource="http://pearson.com/ontology/StudentEnrollment#submittedBy"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Parent"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Person"/>
        <rdfs:range rdf:resource="http://pearson.com/ontology/StudentEnrollment#EnrollmentApplication"/>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasDocument"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#forStudent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#submittedBy"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#targetInstitution"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:label>submits application</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#submittedBy -->

    <owl:ObjectProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#submittedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#EnrollmentApplication"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#hasDocument"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pearson.com/ontology/StudentEnrollment#forStudent"/>
