            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label>visa expiry date (INTL-2: must be after submissionDate)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#visaIssueCountry -->

    <owl:DatatypeProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#visaIssueCountry">
