    </owl:DatatypeProperty>
    


    <!-- http://pearson.com/ontology/StudentEnrollment#visaType -->

    <owl:DatatypeProperty rdf:about="http://pearson.com/ontology/StudentEnrollment#visaType">
        <rdfs:domain rdf:resource="http://pearson.com/ontology/StudentEnrollment#Document"/>
